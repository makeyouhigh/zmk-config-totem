//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ALPHA 0
#define ARROW 1
#define NUM  2
#define MOUSE  3
#define SYM 4
#define FN 5
#define ALLOW 6
#define SYS 7

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <1>;
    trigger-period-ms = <6>;
    delay-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        LSYSLD {
            timeout-ms = <50>;
            key-positions = <34 4>;
            bindings = <&tog 7>;
        };

        BT0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 36>;
        };

        BT1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <6 36>;
        };

        BT2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <7 36>;
        };

        BT3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <8 36>;
        };

        BT4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <9 36>;
        };

        HANGUL {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <27 26>;
        };

        HANJA {
            bindings = <&kp RCTRL>;
            key-positions = <28 27>;
        };

        TASKMGR {
            bindings = <&kp LC(LS(ESCAPE))>;
            key-positions = <10 21 0>;
        };

        COMBO_F2 {
            bindings = <&kp F2>;
            key-positions = <0 1>;
        };

        ALFTF4 {
            bindings = <&kp LA(F4)>;
            key-positions = <1 2>;
        };

        COMBO_F5 {
            bindings = <&kp F5>;
            key-positions = <2 3>;
        };

        COMBO_MINUS {
            bindings = <&kp MINUS>;
            key-positions = <5 15>;
        };

        COMBO_UNDERSOCRE {
            bindings = <&kp UNDER>;
            key-positions = <6 16>;
        };

        COMBO_EQUAL {
            bindings = <&kp EQUAL>;
            key-positions = <17 7>;
        };

        COMBO_PLUS {
            bindings = <&kp PLUS>;
            key-positions = <18 8>;
        };

        COMBO_LPAR {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 13>;
        };

        COMBO_RPAR {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <4 14>;
        };

        COMBO_LBKT {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <11 1>;
        };

        COMBO_RBKT {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <2 12>;
        };

        COMBO_FIND {
            bindings = <&kp LC(F)>;
            key-positions = <12 13 14>;
        };

        COMBO_SAVE {
            bindings = <&kp LC(S)>;
            key-positions = <11 12>;
        };

        COMBO_TABCLOSE {
            bindings = <&kp LC(W)>;
            key-positions = <12 1>;
        };

        COMBO_SCREENSHOT {
            bindings = <&kp LG(LS(S))>;
            key-positions = <10 11 13>;
        };

        COMBO_CAPSLOCK {
            bindings = <&kp CAPSLOCK>;
            key-positions = <28 29>;
        };

        BTCLR {
            bindings = <&bt BT_CLR>;
            key-positions = <19 36>;
        };

        FLUENT {
            bindings = <&kp LC(LA(LS(SPACE)))>;
            key-positions = <11 12 13 33>;
        };

        FLUENT_SHORTCUT {
            bindings = <&kp LC(LA(LS(B)))>;
            key-positions = <11 12 13 32>;
        };

        BT_USB {
            bindings = <&out OUT_TOG>;
            key-positions = <4 33>;
        };

        WINMINIMIZE {
            bindings = <&WINMINIMIZE>;
            key-positions = <24 25>;
        };
    };

    HOME_ROW_R: HOME_ROW_R {
        compatible = "zmk,behavior-hold-tap";
        label = "HOME_ROW_R";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <185>;
    };

    CTRL_CAPS: CTRL_CAPS {
        compatible = "zmk,behavior-tap-dance";
        label = "CTRL_CAPS";
        #binding-cells = <0>;
        bindings = <&kp LCTRL>, <&kp CAPSLOCK>;

        tapping-term-ms = <250>;
    };

    TIMELESS_HMR_L: TIMELESS_HMR_L {
        compatible = "zmk,behavior-hold-tap";
        label = "TIMELESS_HMR_L";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-on-release;
    };

    TIMELESS_HMR_R: TIMELESS_HMR_R {
        compatible = "zmk,behavior-hold-tap";
        label = "TIMELESS_HMR_R";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <280>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <125>;
        flavor = "balanced";
        hold-trigger-on-release;
    };

    HMR_LSHIFT: HMR_LSHIFT {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR_LSHIFT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <170>;
        quick-tap-ms = <0>;
        require-prior-idle-ms = <(-1)>;
        flavor = "balanced";
    };

    HMR_RSHIFT: HMR_RSHIFT {
        compatible = "zmk,behavior-hold-tap";
        label = "HMR_RSHIFT";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <170>;
        quick-tap-ms = <0>;
        require-prior-idle-ms = <(-1)>;
        flavor = "balanced";
    };

    HOME_ROW_L: HOME_ROW_L {
        compatible = "zmk,behavior-hold-tap";
        label = "HOME_ROW_L";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <185>;
    };

    QLT: QLT {
        compatible = "zmk,behavior-hold-tap";
        label = "QLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <220>;
        quick-tap-ms = <200>;
        flavor = "balanced";
        retro-tap;
        require-prior-idle-ms = <125>;
    };

    MLT: MLT {
        compatible = "zmk,behavior-hold-tap";
        label = "MLT";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <185>;
        hold-while-undecided;
    };

    macros {
        WINMINIMIZE: winminimize {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SPACE) &kp N>;
            label = "WINMINIMIZE";
        };
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        ALPHA_layer {
            label = "ALPHA";
            bindings = <
           &kp Q                   &kp W                   &kp E                &kp R                     &kp T        &kp Y         &kp U                     &kp I                &kp O                   &kp P
           &HOME_ROW_L LEFT_GUI A  &HOME_ROW_L LEFT_ALT S  &HOME_ROW_L LCTRL D  &HOME_ROW_L LEFT_SHIFT F  &kp G        &kp H         &HOME_ROW_R LEFT_SHIFT J  &HOME_ROW_R LCTRL K  &HOME_ROW_R LEFT_ALT L  &HOME_ROW_R LEFT_GUI SEMI
&sk LSHFT  &kp Z                   &kp X                   &kp C                &kp V                     &kp B        &kp N         &kp M                     &kp COMMA            &kp DOT                 &kp FSLH                   &sk RSHIFT
                                                           &lt 1 ESCAPE         &lt 2 SPACE               &lt 3 TAB    &QLT 5 ENTER  &QLT 4 SPACE              &QLT 6 BACKSPACE
            >;
        };

        ARROW_layer {
            label = "ARROW";
            bindings = <
           &none         &none         &none      &none           &none            &kp HOME       &kp PAGE_UP  &kp UP      &kp PAGE_DOWN  &kp NON_US_BACKSLASH
           &kp LEFT_WIN  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &none            &kp END        &kp LEFT     &kp DOWN    &kp RIGHT      &kp APOSTROPHE
&kp LC(Y)  &kp LC(Z)     &kp LC(X)     &kp LC(C)  &kp LC(V)       &kp LA(LC(V))    &kp LC(LA(V))  &kp LC(V)    &kp LC(C)   &kp LC(X)      &kp LC(Z)             &kp LC(Y)
                                       &none      &none           &none            &none          &none        &kp DELETE
            >;
        };

        NUM_layer {
            label = "NUM";
            bindings = <
       &none  &none     &kp UP      &none      &none    &kp KP_DIVIDE    &kp N7        &kp N8        &kp N9        &kp KP_MINUS
       &none  &kp LEFT  &kp DOWN    &kp RIGHT  &none    &kp KP_ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp KP_PLUS
&none  &none  &none     &none       &none      &none    &kp COMMA        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL     &none
                        &kp DELETE  &none      &none    &kp BACKSPACE    &kp DOT       &kp NUMBER_0
            >;
        };

        MOUSE_layer {
            label = "MOUSE";
            bindings = <
       &mkp MB4  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &msc SCRL_UP      &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &mkp MB4
       &mkp MB5  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN    &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LC(W)
&none  &none     &none           &none           &none            &none             &none           &none           &none           &none            &none      &none
                                 &mkp LCLK       &mkp RCLK        &none             &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;
        };

        SYM_layer {
            label = "SYM";
            bindings = <
       &kp TILDE          &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp TILDE          &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
       &kp LEFT_BRACKET   &kp DOLLAR       &kp PERCENT   &kp CARET             &kp MINUS                &kp LEFT_BRACKET   &kp DOLLAR       &kp PERCENT   &kp CARET             &kp MINUS
&none  &kp RIGHT_BRACKET  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp NON_US_BACKSLASH     &kp RIGHT_BRACKET  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH              &kp NON_US_BACKSLASH   &none
                                           &none         &none                 &none                    &none              &none            &none
            >;
        };

        FN_layer {
            label = "FN";
            bindings = <
       &none  &kp F7  &kp F8  &kp F9  &kp F10    &kp F7  &kp F8  &kp F9  &kp F10  &none
       &none  &kp F4  &kp F5  &kp F6  &kp F11    &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &none  &kp F1  &kp F2  &kp F3  &kp F12    &kp F1  &kp F2  &kp F3  &kp F12  &none  &none
                      &none   &none   &none      &none   &none   &none
            >;
        };

        ALLOW_layer {
            label = "ALLOW";
            bindings = <
           &kp F12    &kp PAGE_DOWN  &kp UP_ARROW  &kp PAGE_UP  &kp HOME         &none  &none  &none  &none  &none
           &none      &kp LEFT       &kp DOWN      &kp RIGHT    &kp END          &none  &none  &none  &none  &none
&kp LC(Y)  &kp LC(Z)  &kp LC(X)      &kp LC(C)     &kp LC(V)    &kp LC(LA(V))    &none  &none  &none  &none  &none  &none
                                     &none         &kp DELETE   &none            &none  &none  &none
            >;
        };

        SYS_layer {
            label = "SYS";
            bindings = <
            &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4     &none  &none  &none  &none  &none
            &kp F23       &kp F24       &none         &none         &out OUT_TOG     &none  &none  &none  &none  &none
&bt BT_CLR  &kp LC(Z)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(LA(V))    &none  &none  &none  &none  &none  &none
                                        &bootloader   &soft_off     &none            &none  &none  &none
            >;
        };
    };
};
